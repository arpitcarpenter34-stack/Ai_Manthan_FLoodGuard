{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://ai-manthan-floodguard.onrender.com/api/:match*"
    },
    {
      "source": "/samples/:match*",
      "destination": "https://ai-manthan-floodguard.onrender.com/samples/:match*"
    },
    {
      "source": "/health",
      "destination": "https://ai-manthan-floodguard.onrender.com/health"
    },
    {
      "source": "/",
      "destination": "/frontend/static/index.html"
    },
    {
      "source": "/app",
      "destination": "/frontend/static/index.html"
    },
    {
      "source": "/static/(.*)",
      "destination": "/frontend/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/static/$1"
    }
  ]
}
