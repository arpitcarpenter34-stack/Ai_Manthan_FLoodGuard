[TITLE]
;;Project Title/Notes
*MODEL: Sewer catchment model to simulate sewer discharge from Central Fehraltorf to the the treatment plant at ARA Fehraltorf. This model includes the observed transfer flows from RUMLIKON at location 'f02' (node 555) and RUSSIKON at location 'f03' (node 11d). The model is not complete and may still contain errors!
*TRANSFER FLOWS (f02 & f03): measured (in-)flows at f02 and f03. These observations are included as time series inflows (one *.dat file each transfer flow).

[OPTIONS]
;;Option             Value
FLOW_UNITS           LPS
INFILTRATION         GREEN_AMPT
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        YES
SKIP_STEADY_STATE    YES

IGNORE_GROUNDWATER   YES
START_DATE           01/01/1989
START_TIME           00:00:00
REPORT_START_DATE    01/01/1989
REPORT_START_TIME    00:00:00
END_DATE             01/01/2020
END_TIME             00:00:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:30:00
WET_STEP             00:10:00
DRY_STEP             00:30:00
ROUTING_STEP         0:10:00 
RULE_STEP            00:00:00

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  D-W
VARIABLE_STEP        0.75
LENGTHENING_STEP     0
MIN_SURFAREA         1.14
MAX_TRIALS           8
HEAD_TOLERANCE       0.0015
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              4

[EVAPORATION]
;;Data Source    Parameters
;;-------------- ----------------
TIMESERIES       ET_klo
DRY_ONLY         NO

[RAINGAGES]
;;Name           Format    Interval SCF      Source    
;;-------------- --------- ------ ------ ----------
rain_gauge       VOLUME    00:10    1.0      FILE       "input_files_2019/r02.dat" r02        MM   

