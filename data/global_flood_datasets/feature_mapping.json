        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "surface_runoff": {
      "description": "Precipitation that flows overland rather than infiltrating into soil",
      "target_unit": "mm",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input_or_static_attribute",
      "sources": {
