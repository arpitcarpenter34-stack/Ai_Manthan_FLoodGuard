          "source_field": "ro (Total runoff)",
          "source_unit": "m",
          "conversion_to_target": "val * 1000.0",
          "status": "Available in CDS",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "None (USGS measures total channel streamflow, not isolated surface overland runoff)",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
