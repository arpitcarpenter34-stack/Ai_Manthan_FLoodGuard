      "sources": {
        "CAMELSH_Attributes": {
          "source_field": "ELEV_SITE_M (gauge elevation), ELEV_MEAN_M_BASIN (mean basin elevation)",
          "source_unit": "m",
          "conversion_to_target": "Direct",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "alt_va (Altitude / Gauge Datum elevation) in site service",
          "source_unit": "ft",
          "conversion_to_target": "val * 0.3048",
