    "flood_event": {
      "description": "Binary ground-truth indicator of whether a flood condition occurred",
      "target_unit": "binary (0 or 1)",
      "data_type": "categorical_binary",
      "role": "supervision_target_label",
      "sources": {
        "NOAA_Storm_Events": {
