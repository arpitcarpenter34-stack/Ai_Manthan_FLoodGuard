        },
        "ERA5_Hourly": {
          "source_field": "swvl1 (Volumetric soil water layer 1)",
          "source_unit": "m3/m3",
          "conversion_to_target": "Direct",
          "status": "Available in ERA5 land surface components",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "None on standard stream gauges",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
