          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
