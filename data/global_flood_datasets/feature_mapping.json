{
  "metadata": {
    "version": "1.0.0",
    "description": "Standardized hydrological and flood feature mapping across global datasets for HYDRO-GUARD AI ST-GNN pipeline",
    "target_features_count": 16,
    "evaluated_datasets": [
      "CAMELSH_Hourly",
      "CAMELSH_Attributes",
      "ERA5_Hourly",
      "ERA5_Land",
      "USGS_NWIS",
      "NOAA_Storm_Events",
      "Global_Flood_DB"
    ]
  },
  "features": {
    "precipitation_mm": {
      "description": "Total liquid and frozen water equivalent reaching the ground over time interval",
      "target_unit": "mm",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input",
      "sources": {
        "CAMELSH_Hourly": {
          "source_field": "precipitation (in timeseries.7z forcing) / PPTAVG_BASIN (climatological annual average in attributes)",
          "source_unit": "mm/h or cm/year",
          "conversion_to_target": "Direct (for hourly forcing) or monthly/annual rate",
          "status": "Available in full timeseries.7z / Attributes contain climatological baselines",
          "is_direct_match": true
        },
        "ERA5_Hourly": {
          "source_field": "precipitation / tp (Total precipitation)",
          "source_unit": "mm (or m in GRIB)",
          "conversion_to_target": "x 1000 if in meters, else direct",
          "status": "Available",
          "is_direct_match": true
        },
        "ERA5_Land": {
          "source_field": "tp (Total precipitation)",
          "source_unit": "m",
          "conversion_to_target": "val * 1000.0",
          "status": "Available",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "00045 (Precipitation, cumulative) on select rain gauges",
          "source_unit": "inches",
          "conversion_to_target": "val * 25.4",
          "status": "Sparse / Missing on pure streamflow stations",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None (Qualitative narrative text only)",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None (Satellite inundation extent)",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "rainfall_intensity": {
      "description": "Rate of precipitation per unit time",
      "target_unit": "mm/h",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input",
      "sources": {
        "CAMELSH_Hourly": {
          "source_field": "Hourly precipitation rate in forcing timeseries",
          "source_unit": "mm/h",
          "conversion_to_target": "Direct",
          "status": "Available in forcing archive",
          "is_direct_match": true
        },
        "ERA5_Hourly": {
          "source_field": "precipitation",
          "source_unit": "mm/h",
          "conversion_to_target": "Direct (hourly total = mm/h rate)",
          "status": "Available",
          "is_direct_match": true
        },
        "ERA5_Land": {
          "source_field": "tp",
          "source_unit": "m/h",
          "conversion_to_target": "val * 1000.0",
          "status": "Available",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "streamflow_m3s": {
      "description": "Volumetric rate of water flow through river/drainage cross-section",
      "target_unit": "m3/s",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_target_and_feature",
      "sources": {
        "CAMELSH_Hourly": {
          "source_field": "streamflow (in Hourly2/<STAID>_hourly.nc)",
          "source_unit": "m3 s-1",
          "conversion_to_target": "Direct (native SI units)",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "CAMELSH_Attributes": {
          "source_field": "dis_m3_pyr (HydroATLAS annual discharge), dis_m3_pmn (min), dis_m3_pmx (max)",
          "source_unit": "m3/s",
          "conversion_to_target": "Direct",
          "status": "Available (Climatological)",
          "is_direct_match": true
        },
        "ERA5_Hourly": {
          "source_field": "None directly in standard single levels (requires GloFAS river discharge coupling)",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable in single levels",
          "is_direct_match": false
        },
        "ERA5_Land": {
          "source_field": "None directly (produces runoff, not channel discharge)",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "USGS_NWIS": {
          "source_field": "00060 (Streamflow, mean daily or instantaneous)",
          "source_unit": "ft3/s (cfs)",
          "conversion_to_target": "val * 0.028316846592",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "water_level_m": {
      "description": "Height of water surface relative to local gauge datum or channel bed",
      "target_unit": "m",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_target_and_feature",
      "sources": {
        "CAMELSH_Hourly": {
          "source_field": "water_level (in Hourly2/<STAID>_hourly.nc)",
          "source_unit": "m",
          "conversion_to_target": "Direct (native SI units)",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "00065 (Gage height)",
          "source_unit": "ft",
          "conversion_to_target": "val * 0.3048",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "ERA5_Hourly": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "ERA5_Land": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "MAGNITUDE (crest level reported for select river flood events)",
          "source_unit": "ft",
          "conversion_to_target": "val * 0.3048",
          "status": "Sparse (<5% reporting)",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "temperature_c": {
      "description": "Ambient air temperature at 2 meters above ground",
      "target_unit": "\u00b0C",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input_or_static_attribute",
      "sources": {
        "ERA5_Hourly": {
          "source_field": "temperature_2m",
          "source_unit": "\u00b0C (or K)",
          "conversion_to_target": "val - 273.15 if in Kelvin else direct",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "ERA5_Land": {
          "source_field": "2t (2 metre temperature)",
          "source_unit": "K",
          "conversion_to_target": "val - 273.15",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "CAMELSH_Attributes": {
          "source_field": "T_AVG_BASIN, T_AVG_SITE, T_MAX_BASIN, T_MIN_BASIN",
          "source_unit": "\u00b0C",
          "conversion_to_target": "Direct (Climatological static attribute)",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "00010 (Water temperature) / 00020 (Air temperature) on select stations",
          "source_unit": "\u00b0C",
          "conversion_to_target": "Direct",
          "status": "Sparse across hydrometric network",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "humidity_pct": {
      "description": "Relative humidity of ambient air",
      "target_unit": "%",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input_or_static_attribute",
      "sources": {
        "ERA5_Hourly": {
          "source_field": "relative_humidity_2m",
          "source_unit": "%",
          "conversion_to_target": "Direct",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "CAMELSH_Attributes": {
          "source_field": "RH_BASIN, RH_SITE",
          "source_unit": "%",
          "conversion_to_target": "Direct (Climatological static attribute)",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "ERA5_Land": {
          "source_field": "Derived from 2t (temperature) and 2d (dewpoint temperature)",
          "source_unit": "Calculated via Tetens formula",
          "conversion_to_target": "100.0 * (exp((17.27 * td) / (td + 237.3)) / exp((17.27 * t) / (t + 237.3)))",
          "status": "Computable",
          "is_direct_match": false
        },
        "USGS_NWIS": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "wind_speed_ms": {
      "description": "Wind speed at 10 meters above surface",
      "target_unit": "m/s",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input",
      "sources": {
        "ERA5_Hourly": {
          "source_field": "wind_speed_10m / sqrt(10u^2 + 10v^2)",
          "source_unit": "m/s",
          "conversion_to_target": "Direct",
          "status": "Available (Acquired)",
          "is_direct_match": true
        },
        "ERA5_Land": {
          "source_field": "10u, 10v (u and v components of 10m wind)",
          "source_unit": "m/s",
          "conversion_to_target": "sqrt(u^2 + v^2)",
          "status": "Available",
          "is_direct_match": true
        },
        "CAMELSH_Hourly": {
          "source_field": "None in Hourly2 / Available in NLDAS2 forcing archive",
          "source_unit": "m/s",
          "conversion_to_target": "Direct",
          "status": "Available in full timeseries.7z",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "MAGNITUDE (knots, on thunderstorm wind events only)",
          "source_unit": "knots",
          "conversion_to_target": "val * 0.514444",
          "status": "Unavailable on flood events",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "surface_pressure_hpa": {
      "description": "Atmospheric surface pressure at station/pixel elevation",
      "target_unit": "hPa",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input",
      "sources": {
        "ERA5_Hourly": {
          "source_field": "surface_pressure",
          "source_unit": "hPa (or Pa)",
