          "source_unit": "Pa",
          "conversion_to_target": "val / 100.0",
          "status": "Available in full timeseries.7z",
          "is_direct_match": true
        },
        "USGS_NWIS": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "NOAA_Storm_Events": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        },
        "Global_Flood_DB": {
          "source_field": "None",
          "source_unit": "None",
          "conversion_to_target": "N/A",
          "status": "Unavailable",
          "is_direct_match": false
        }
      }
    },
    "soil_moisture": {
      "description": "Volumetric water content of topsoil",
      "target_unit": "m3/m3 (or % volume)",
      "data_type": "continuous_float",
      "role": "dynamic_temporal_input_or_static_attribute",
      "sources": {
